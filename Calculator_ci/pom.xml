         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>fp</groupId>
    <artifactId>Calculator_ci</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <description>Sample application generated by com.a9ski:quick-start</description>

    <url>https://github.com/Néstor/Calculator_ci</url>
    <inceptionYear>2026</inceptionYear>
    <organization>
        <name>Néstor</name>
        <url>https://github.com/Néstor</url>
    </organization>

    <developers>
        <developer>
            <id>Néstor</id>
            <name>Néstor</name>
            <email>Néstor@internet.rar</email>
            <url>https://github.com/Néstor</url>
        </developer>
    </developers>

    <scm>
        <url>https://github.com/Néstor/Calculator_ci</url>
        <connection>scm:git:ssh://git@github.com/Néstor/Calculator_ci.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/Néstor/Calculator_ci.git</developerConnection>
        <tag>HEAD</tag>
    </scm>
    <licenses>
        <license>
            <name>apache_v2</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
            <comments>A business-friendly OSS license</comments>
        </license>
    </licenses>


    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>

        <maven.test.plugins.version>3.0.0-M6</maven.test.plugins.version>

        <lombok.version>1.18.24</lombok.version>
        <junit.version>6.1.3</junit.version>
        
    </properties>

    <dependencies>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven.test.plugins.version}</version>
            </plugin>
            <plugin>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>${maven.test.plugins.version}</version>
            </plugin>
        </plugins>
    </build>

</project>
